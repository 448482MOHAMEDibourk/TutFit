{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Debug",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {},
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Run All",
      "configurations": ["Backend: Debug"],
      "preLaunchTask": "Frontend: Dev",
      "presentation": {
        "hidden": false,
        "group": "dev",
        "order": 1
      }
    }
  ]
}
